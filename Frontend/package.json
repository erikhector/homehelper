{
  "name": "vite-react",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "repository": {},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "> 0.2%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "predev": "pwsh -NoProfile -ExecutionPolicy Unrestricted -Command ./check-npm.ps1",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --cache --fix",
    "lint:imports": "eslint . --cache --fix --rule \"unused-imports/no-unused-imports: 1\" && npm run prettier:fix",
    "lint:check": "eslint . --cache",
    "lint:check:ci": "eslint . --max-warnings=0 --color",
    "lint:perf": "set TIMING=1 && eslint . --cache --cache-strategy metadata",
    "lint:inspect": "eslint --inspect-config",
    "format": "prettier \"src/**/*.{ts,tsx,js,css,scss}\" --cache --write",
    "format:check": "prettier \"src/**/*.{ts,tsx,js,css,scss}\" --cache --check",
    "lintstyle": "stylelint \"src/**/*.{css,scss}\" --cache --fix",
    "lintstyle:check": "stylelint \"src/**/*.{css,scss}\" --cache",
    "backend": "dotnet run --project ../Backend",
    "prepare": "cd .. && husky Frontend/.husky",
    "knip": "knip -c knip.config.js",
    "genpwaassets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.2",
    "@locator/runtime": "^0.5.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.100.11",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "check-dependencies": "^2.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^9.0.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "react-compiler-runtime": "^1.0.0",
    "react-scan": "^0.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@dekiru/debug-panel": "^1.3.1",
    "@dekiru/react-error-boundary": "^0.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router": "^7.15.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,css,scss,json}": [
      "prettier --write --cache"
    ]
  },
  "volta": {
    "node": "22.22.3"
  }
}
