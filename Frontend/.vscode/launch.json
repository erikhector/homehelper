{
  "version": "1.0.0",
  // runtimeArgs for chromium browser: Performance optimization: Disable unnecessary Chrome features that can interfere with debugging and slow down the process
  // skipFiles: Skip stepping into library code in node_modules and Node.js internals
  // "resolveSourceMapLocations": Performance optimization: Only resolve source maps for our own code, not for dependencies in node_modules
  "configurations": [
    {
      "name": "Chrome",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "frontend-debug",
      "postDebugTask": "kill-debug-process",
      "sourceMaps": true,
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": ["--disable-infobars --disable-session-crashed-bubble --disable-translate --disable-background-mode"],
      "skipFiles": ["${workspaceFolder}/node_modules/**/*.js", "<node_internals>/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Edge",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "frontend-debug",
      "postDebugTask": "kill-debug-process",
      "sourceMaps": true,
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": ["--disable-infobars --disable-session-crashed-bubble --disable-translate --disable-background-mode"],
      "skipFiles": ["${workspaceFolder}/node_modules/**/*.js", "<node_internals>/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Brave",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "C:\\Program Files (x86)\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
      "preLaunchTask": "frontend-debug",
      "postDebugTask": "kill-debug-process",
      "sourceMaps": true,
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": ["--disable-infobars --disable-session-crashed-bubble --disable-translate --disable-background-mode"],
      "skipFiles": ["${workspaceFolder}/node_modules/**/*.js", "<node_internals>/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Firefox Dev Edition",
      "type": "firefox",
      "request": "launch",
      "preLaunchTask": "frontend-debug",
      "postDebugTask": "kill-debug-process",
      "reAttach": false,
      "profile": "dev-edition-default",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "skipFiles": ["${workspaceFolder}/node_modules/**/*.js", "<node_internals>/**/*.js"]
    },
    {
      "name": "Firefox",
      "type": "firefox",
      "request": "launch",
      "preLaunchTask": "frontend-debug",
      "postDebugTask": "kill-debug-process",
      "reAttach": false,
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "skipFiles": ["${workspaceFolder}/node_modules/**/*.js", "<node_internals>/**/*.js"]
    }
  ],
  "compounds": [
    {
      "name": "Chrome & Backend",
      "configurations": ["Chrome", "Backend"]
    },
    {
      "name": "Edge & Backend",
      "configurations": ["Edge", "Backend"]
    },
    {
      "name": "Brave & Backend",
      "configurations": ["Brave", "Backend"]
    },
    {
      "name": "Firefox & Backend",
      "configurations": ["Firefox", "Backend"]
    }
  ]
}
