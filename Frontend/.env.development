### INFO ###
# DEV SETTINGS.
# If you want to use settings unique to your local development,
# create a .env.development.local file with that will be ignored by git.
# with your local overrides.
# See https://vite.dev/guide/env-and-mode#env-variables
### INFO ###

# ONLY EXPOSED IN VITE CONFIG
CONFIG_OPEN=true # or a URL to open
CONFIG_PORT=8080
CONFIG_PROXY_URL=http://localhost:5000 # Usually a backend server URL. Ie. http://localhost:5000
CONFIG_BUNDLE_ANALYZE=false
CONFIG_ESLINT_FLAG_CONFIG=true
CONFIG_REACT_COMPILER=false
CONFIG_PWA=false

# BUILT IN ENV VARIABLES
# https://vite.dev/config/server-options#server-open
# https://github.com/sindresorhus/open?tab=readme-ov-file#supported-apps
# When not set, the system default browser will be used
# Override in .env.development.local if needed
BROWSER=

# EXPOSED IN APP (AND VITE CONFIG)
VITE_REACT_AXE=true # Dev specific tool (runs only in development mode)
VITE_LOCATOR_JS=true # Dev specific tool (runs only in development mode)
VITE_REACT_SCAN=false # Dev specific tool (runs only in development mode). Only enable when needed as it impacts performance