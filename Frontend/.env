### INFO ###
# DO NOT ENTER SENSITIVE VALUES IN .env FILES.
# SETTINGS PREFIXED WITH "VITE_" WILL BE INJECTED AND EXPOSED IN APP CODE (AND VITE CONFIG)
# See https://vite.dev/guide/env-and-mode#env-variables
### INFO ###

VITE_APP_LANG=en
VITE_APP_TITLE=React template
VITE_BASE_URL=/
CONFIG_REACT_COMPILER=false
CONFIG_PWA=false